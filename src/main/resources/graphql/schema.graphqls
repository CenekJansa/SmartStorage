enum FieldType {
    STRING
    DATE
    NUMBER
}

input StorageSectionFieldInput {
    name: String!
    type: FieldType!
    identifier: Boolean!
}

type StorageSectionFieldResult {
    name: String!
    type: FieldType!
    identifier: Boolean!
}

type StorageSectionResult {
    id: ID!
    name: String!
    attributes: [StorageSectionFieldResult!]!
}

type DataPair {
    key: String!
    value: String
}

type StorageItemResult {
    id: ID!
    name: String!
    metadata: [DataPair!]!
}

type UploadResult {
    success: Boolean!
    attachmentId: ID
    errorMessage: String
}

type Query {
    status: String
    retrieveStorageSections: [StorageSectionResult!]!
    retrieveStorageItems(sectionId: ID!): [StorageItemResult!]!
}

type Mutation {
    createStorageSection(name: String!, attributes: [StorageSectionFieldInput!]!): StorageSectionResult!
    uploadDocument(sectionId: ID!, file: Upload!): UploadResult!
}
